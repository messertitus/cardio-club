EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Web Push (background notifications). Public half of the VAPID key pair; the
# client subscribes with it. The PRIVATE half lives ONLY as a Supabase secret
# for the send-push edge function — never put it here. Generate a pair with:
#   npx web-push generate-vapid-keys
# Without this, only foreground (app-open) notifications work. See docs/push-setup.md.
EXPO_PUBLIC_VAPID_PUBLIC_KEY=
