# Optional: enables live numbers on the landing page at BUILD time via the
# public `landing_public_stats` RPC (migration 068). Without these, the build
# falls back to the committed JSON in src/data/ — the site still builds fine.
#
# Use the SAME values as the app (publishable / anon key only — never the
# service-role key). Read at build time only; the anon key is publishable.
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key
