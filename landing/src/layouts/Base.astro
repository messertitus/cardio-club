---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}
const {
  title = 'Messers Cardio Club',
  description = 'Der private Cardio-Club am Bodensee in Konstanz. Eine gemeinsame Sport-Session pro Woche — aktuell nur mit Einladungscode.',
  noindex = false,
} = Astro.props;
const appUrl = 'https://app.messers-cardio-club.com';
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#05070b" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap"
    />
  </head>
  <body>
    <div class="scroll-progress" id="scroll-progress" aria-hidden="true"></div>
    <div class="bg-orbs" aria-hidden="true"><span></span><span></span><span></span></div>

    <header class="site-header wrap">
      <a class="brand" href="/">
        <img class="mark" src="/brand/mcc-symbol.png" alt="" width="34" height="34" />
        <span class="brand-name" data-i18n="brand">Messers&nbsp;Cardio&nbsp;Club</span>
      </a>
      <nav class="head-nav">
        <button class="lang-switch" type="button" data-lang-toggle aria-label="Switch language">EN</button>
        <a class="nav-link" href="/faq" data-i18n="nav.faq">FAQ</a>
        <a class="btn btn-ghost" href={appUrl} data-i18n="nav.app">Zur App</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer wrap">
      <a class="foot-brand" href="/" aria-label="Messers Cardio Club">
        <img class="foot-logo" src="/brand/mcc-logo.png" alt="Messers Cardio Club" width="150" height="150" />
      </a>
      <nav class="foot-nav">
        <a href="/" data-i18n="nav.start">Start</a>
        <a href="/faq" data-i18n="nav.faq">FAQ</a>
        <a href="/impressum" data-i18n="nav.impressum">Impressum</a>
        <a href="/datenschutz" data-i18n="nav.datenschutz">Datenschutz</a>
        <a href={appUrl} data-i18n="nav.app">Zur App</a>
      </nav>
      <div class="foot-bottom">
        <span>© {new Date().getFullYear()} Messers Cardio Club</span>
        <span class="sep">·</span>
        <span class="dim" data-i18n="footer.tagline">Konstanz · Bodensee</span>
      </div>
    </footer>

    <script>
      import '../scripts/reveal';
      import '../scripts/lang';
      import '../scripts/spotlight';
    </script>

    <style>
      .site-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding-block: 22px;
      }
      .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.7em;
        font-weight: 700;
        letter-spacing: 0.01em;
        min-width: 0;
      }
      .brand .mark {
        width: 34px; height: 34px; object-fit: contain; flex: none;
        filter: drop-shadow(0 0 10px rgba(77, 163, 255, 0.45));
      }
      .head-nav { display: flex; align-items: center; gap: 18px; }
      .nav-link {
        font-size: 0.92rem; font-weight: 600; color: var(--text-dim);
        transition: color 0.2s ease; white-space: nowrap;
      }
      .nav-link:hover { color: var(--blue); }
      .lang-switch {
        font: inherit; font-size: 0.78rem; font-weight: 800; letter-spacing: 0.06em;
        color: var(--text-dim); background: rgba(255,255,255,0.03);
        border: 1px solid var(--line); border-radius: 999px;
        padding: 5px 11px; cursor: pointer; transition: color 0.2s, border-color 0.2s;
      }
      .lang-switch:hover { color: var(--blue); border-color: var(--strong-line); }

      .site-footer {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: 22px;
        padding-block: 52px 44px;
        margin-top: 72px;
        border-top: 1px solid var(--line);
        color: var(--text-dim);
        font-size: 0.9rem;
      }
      .foot-brand { display: inline-flex; }
      .foot-logo {
        width: auto; height: clamp(104px, 16vw, 140px); object-fit: contain;
        filter: drop-shadow(0 0 22px rgba(77, 163, 255, 0.28));
      }
      .foot-nav { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px 24px; }
      .foot-nav a { color: var(--text-dim); transition: color 0.2s ease; }
      .foot-nav a:hover { color: var(--blue); }
      .foot-bottom { display: flex; justify-content: center; gap: 8px; flex-wrap: wrap; font-size: 0.84rem; }
      .foot-bottom .sep { color: var(--text-muted); }
      .dim { color: var(--text-muted); }

      @media (max-width: 560px) {
        .site-header { padding-block: 16px; }
      }
    </style>
  </body>
</html>
