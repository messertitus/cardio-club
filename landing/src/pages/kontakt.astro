---
import Base from '../layouts/Base.astro';

const env = import.meta.env as Record<string, string | undefined>;
const contactConfig = {
  url: env.PUBLIC_SUPABASE_URL ?? env.SUPABASE_URL ?? env.EXPO_PUBLIC_SUPABASE_URL ?? '',
  key: env.PUBLIC_SUPABASE_ANON_KEY ?? env.SUPABASE_ANON_KEY ?? env.EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY ?? '',
};
---

<Base title="Kontakt — Messers Cardio Club" description="Kontaktiere den Messers Cardio Club: Fragen, Feedback oder Interesse am Club.">
  <article class="prose contact">
    <span class="eyebrow"><span class="pip"></span><span data-i18n="contact.eyebrow">Kontakt</span></span>
    <h1 data-i18n="contact.h1">Schreib uns</h1>
    <p class="lead" data-i18n="contact.lede">
      Fragen, Feedback oder Interesse am Club? Schreib uns — wir antworten.
    </p>

    <form class="form-card" id="contact-form">
      <label><span data-i18n="contact.name">Name</span>
        <input name="name" type="text" required maxlength="120" autocomplete="name" data-i18n-ph="contact.namePh" placeholder="Dein Name" />
      </label>
      <label><span data-i18n="contact.email">E-Mail</span>
        <input name="email" type="email" required maxlength="160" autocomplete="email" data-i18n-ph="contact.emailPh" placeholder="du@beispiel.de" />
      </label>
      <label><span data-i18n="contact.message">Nachricht</span>
        <textarea name="message" required maxlength="4000" rows="6" data-i18n-ph="contact.messagePh" placeholder="Worum geht’s?"></textarea>
      </label>
      <input type="text" name="company" class="hp-field" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <button class="btn btn-primary" type="submit" data-contact-submit data-i18n="contact.submit">Nachricht senden</button>
      <p class="form-msg" data-contact-msg hidden></p>
      <p class="form-fine" data-i18n="contact.fine">
        Mit dem Absenden stimmst du der Speicherung deiner Angaben zur Bearbeitung deiner Anfrage zu (siehe <a href="/datenschutz">Datenschutz</a>).
      </p>
    </form>
  </article>

  <script type="application/json" id="contact-config" set:html={JSON.stringify(contactConfig)} is:inline />
  <script>
    import '../scripts/contact';
  </script>
</Base>

<style>
  .contact { max-width: 620px; }
  .form-card {
    display: flex; flex-direction: column; gap: 14px;
    margin-top: 2rem; padding: clamp(22px, 4vw, 32px);
    border-radius: 22px; border: 1px solid var(--line); background: var(--surface);
  }
  .form-card label { display: flex; flex-direction: column; gap: 7px; font-size: 0.82rem; font-weight: 700; color: var(--text-dim); }
  .form-card input, .form-card textarea {
    padding: 12px 14px; border-radius: 12px;
    border: 1px solid var(--line); background: rgba(255, 255, 255, 0.04);
    color: var(--text); font: inherit; font-weight: 500; resize: vertical;
  }
  .form-card input:focus, .form-card textarea:focus {
    outline: none; border-color: var(--blue); background: rgba(77, 163, 255, 0.06);
  }
  .form-card .btn { margin-top: 4px; justify-content: center; }
  .form-msg { margin: 0; font-size: 0.9rem; font-weight: 700; }
  .form-msg[hidden] { display: none; }
  .form-msg.ok { color: var(--mint); }
  .form-msg.err { color: var(--coral); }
  .form-fine { margin: 2px 0 0; font-size: 0.76rem; color: var(--text-muted); line-height: 1.4; }
  .form-fine a { color: var(--blue); }
</style>
