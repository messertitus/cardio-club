---
import Base from '../layouts/Base.astro';
import RegionMap from '../components/RegionMap.astro';
import Icon from '../components/Icon.astro';
import { getClubData } from '../lib/clubData';
import { sportIconPath } from '../lib/icons';
import {
  mdiHandWaveOutline, mdiFormatListNumbered, mdiHandBackLeftOutline,
  mdiSort, mdiShieldCheckOutline, mdiHistory, mdiScaleBalance,
  mdiMapMarkerRadiusOutline, mdiVectorCombine,
  mdiCalendarStar, mdiArrowRight, mdiMapMarker,
  mdiShuffleVariant, mdiMapMarkerMultipleOutline,
} from '@mdi/js';

// "Was den Club besonders macht" — the differentiators.
const usp = [
  { icon: mdiShuffleVariant, t: 'Viele Sportarten', d: 'Kein Einheitsbrei: ein rotierender Pool, jede Woche neu gewählt — von Schwimmen bis Outdoor-Boxen.' },
  { icon: mdiMapMarkerMultipleOutline, t: 'Viele Standorte', d: 'Quer durch Konstanz und an den Bodensee — verschiedene Orte statt immer derselben Halle.' },
  { icon: mdiScaleBalance, t: 'Fair-First-Algorithmus', d: 'Nicht die größte oder lauteste Gruppe gewinnt — ein Algorithmus wählt fair die beste Kombination aus Sport und Ort.' },
];

const appUrl = 'https://app.messers-cardio-club.com';
const club = await getClubData();

// Country dial codes for the waitlist phone field (matches the app's format).
const dialCodes = [
  { code: '+49', flag: '🇩🇪' }, { code: '+43', flag: '🇦🇹' }, { code: '+41', flag: '🇨🇭' },
  { code: '+33', flag: '🇫🇷' }, { code: '+39', flag: '🇮🇹' }, { code: '+31', flag: '🇳🇱' },
  { code: '+32', flag: '🇧🇪' }, { code: '+352', flag: '🇱🇺' }, { code: '+34', flag: '🇪🇸' },
  { code: '+44', flag: '🇬🇧' }, { code: '+48', flag: '🇵🇱' }, { code: '+420', flag: '🇨🇿' },
  { code: '+1', flag: '🇺🇸' },
];

const stats = [
  { key: 'sports', value: String(club.sportsActive), label: 'Sportarten' },
  { key: 'venues', value: String(club.venues.length), label: 'Standorte' },
  { key: 'members', value: `${club.membersIsEstimate ? '~' : ''}${club.members}`, label: 'Mitglieder' },
  { key: 'cardiotage', value: String(club.weeklyCardiotage), label: 'Tage/Woche' },
];

// "Dein Teil" — the three inputs the decision actually uses (from the app's
// how-it-works screen).
const yourPart = [
  { icon: mdiHandWaveOutline, t: 'Bist du dabei?', d: 'Sag, ob du zum Cardiotag kommst. Nur wer dabei ist, zählt mit.' },
  { icon: mdiFormatListNumbered, t: 'Deine Wunsch-Sportarten', d: 'Wähle deine Favoriten in deiner Reihenfolge — ganz oben zählt am meisten.' },
  { icon: mdiHandBackLeftOutline, t: 'Deine No-Gos', d: 'Was für dich gar nicht geht, markierst du. Das wird respektiert.' },
];

// "Fair statt laut" — what the club weighs so it's fair, not just loud.
const fairness = [
  { icon: mdiSort, t: 'Reihenfolge zählt', d: 'Ranked Voting: höhere Plätze geben mehr Gewicht — fairer als nur eine Stimme pro Person.' },
  { icon: mdiShieldCheckOutline, t: 'No-Gos sind hart', d: 'Was viele ablehnen, wird nur im Notfall gewählt. Niemand soll sich gezwungen fühlen.' },
  { icon: mdiHistory, t: 'Vernachlässigungs-Schutz', d: 'Wer lange nicht dran war, bekommt mehr Gewicht — nicht immer dieselbe Gruppe.' },
  { icon: mdiScaleBalance, t: 'Mehrheits-Schutz', d: 'Eine klare Mehrheit wird nicht von einer kleinen Gruppe überstimmt.' },
  { icon: mdiMapMarkerRadiusOutline, t: 'Passt der Standort?', d: 'Gruppengröße, Indoor/Outdoor und Wetter fließen ein — es muss am Tag machbar sein.' },
  { icon: mdiVectorCombine, t: 'Manchmal mehrere Gruppen', d: 'Wenn es passt, laufen parallele Sportarten — so bekommen mehr Leute ihre Wahl.' },
];
---

<Base>
  <!-- HERO -->
  <section class="hero wrap">
    <div class="hero-copy">
      <span class="eyebrow" data-reveal><span class="pip"></span>{club.city} · {club.region}</span>
      <h1 data-reveal>
        <span class="h1-line" data-i18n="hero.h1a">Der Cardio-Club</span><br />
        <span class="grad" data-i18n="hero.h1b">am Bodensee.</span>
      </h1>
      <p class="lede" data-reveal data-i18n="hero.lede">
        Gemeinsame <strong>Cardiotage</strong> am See — jede Woche zusammen
        abgestimmt und fair entschieden. Ein Club, viele Sportarten, ein fester
        Rhythmus.
      </p>

      <div class="invite-pill" data-reveal>
        <span class="dotpulse"></span>
        <span data-i18n="hero.invite"><strong>Launch steht bevor</strong> —<br />wir testen gerade die App für euch</span>
      </div>

      <div class="cta" data-reveal>
        <button class="btn btn-primary" type="button" data-open-waitlist>
          <span data-i18n="hero.cta">Einladungscode anfragen</span> <Icon path={mdiArrowRight} />
        </button>
      </div>

      <dl class="stats" data-reveal>
        {stats.map((s) => (
          <div>
            <dt data-stat={s.key} data-countup>{s.value}</dt>
            <dd data-i18n={`stat.${s.key}`}>{s.label}</dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="hero-map" id="standorte" data-reveal>
      <RegionMap />
      <p class="map-caption">
        <span class="pip"></span><span data-i18n="map.caption">Leuchtende Punkte = aktive Sport-Standorte. Größe nach Anzahl der Sportarten vor Ort.</span>
      </p>
    </div>
  </section>

  <!-- ECG signature divider -->
  <div class="ecg wrap" aria-hidden="true">
    <svg viewBox="0 0 1200 80" preserveAspectRatio="none">
      <path class="ecg-base" d="M0 40 H440 l14 -28 l16 56 l14 -40 l12 24 H560 l18 -52 l20 64 l14 -24 H1200" />
      <path class="ecg-pulse" d="M0 40 H440 l14 -28 l16 56 l14 -40 l12 24 H560 l18 -52 l20 64 l14 -24 H1200" />
    </svg>
  </div>

  <!-- USP — what makes the club special -->
  <section class="usp wrap">
    <div class="sec-head" data-reveal>
      <span class="eyebrow"><span class="pip"></span><span data-i18n="usp.eyebrow">Was den Club besonders macht</span></span>
      <h2 data-i18n="usp.h2">Nicht noch eine Sportgruppe</h2>
      <p class="sec-lede" data-i18n="usp.lede">
        Verschiedene Sportarten an verschiedenen Standorten — und welche Kombination
        läuft, entscheidet ein fairer Algorithmus, nicht die lauteste Stimme.
      </p>
    </div>
    <div class="usp-grid">
      {usp.map((u, i) => (
        <div class="usp-card" data-reveal>
          <span class="usp-icon"><Icon path={u.icon} size={26} /></span>
          <h3 data-i18n={`usp.${i}.t`}>{u.t}</h3>
          <p data-i18n={`usp.${i}.d`}>{u.d}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- SPORTS -->
  <section class="sports wrap" id="sportarten">
    <div class="sec-head">
      <span class="eyebrow" data-reveal><span class="pip"></span><span data-i18n="sports.eyebrow">Das Programm</span></span>
      <h2 data-reveal><span data-stat="sports" data-countup>{club.sportsActive}</span> <span data-i18n="sports.h2">Sportarten im Pool</span></h2>
      <p class="sec-lede" data-reveal data-i18n="sports.lede">
        Jede Woche wählt der Club gemeinsam aus dem Pool — nie „immer das Gleiche".
      </p>
    </div>
    <ul class="sport-grid" id="sport-grid">
      {club.sports.map((s) => (
        <li class="sport" data-reveal>
          <span class="s-icon"><Icon path={sportIconPath(s.name, s.icon)} size={26} /></span>
          <span class="s-name">{s.name}</span>
        </li>
      ))}
    </ul>
  </section>

  <!-- YOUR PART -->
  <section class="part wrap" id="ablauf">
    <div class="sec-head">
      <span class="eyebrow" data-reveal><span class="pip"></span><span data-i18n="part.eyebrow">Dein Teil</span></span>
      <h2 data-reveal data-i18n="part.h2">Du gibst den Ton an</h2>
      <p class="sec-lede" data-reveal data-i18n="part.lede">
        Drei kurze Eingaben pro Woche — mehr braucht der Club nicht von dir.
      </p>
    </div>
    <div class="part-grid">
      {yourPart.map((s, i) => (
        <div class="part-card" data-reveal>
          <span class="part-icon"><Icon path={s.icon} size={22} /></span>
          <span class="part-n">{String(i + 1).padStart(2, '0')}</span>
          <h3 data-i18n={`part.${i}.t`}>{s.t}</h3>
          <p data-i18n={`part.${i}.d`}>{s.d}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- FAIRNESS -->
  <section class="fair wrap">
    <div class="sec-head">
      <span class="eyebrow" data-reveal><span class="pip"></span><span data-i18n="fair.eyebrow">So entscheidet der Club</span></span>
      <h2 data-reveal data-i18n="fair.h2">Fair statt laut</h2>
      <p class="sec-lede" data-reveal data-i18n="fair.lede">
        Kurz vor dem Cardiotag entscheidet der Club automatisch — nach klaren,
        gleichen Regeln für alle. Kein endloses Hin und Her im Chat.
      </p>
    </div>
    <ul class="fair-grid">
      {fairness.map((f, i) => (
        <li class="fair-card" data-reveal>
          <span class="fair-icon"><Icon path={f.icon} size={20} /></span>
          <div>
            <h3 data-i18n={`fair.${i}.t`}>{f.t}</h3>
            <p data-i18n={`fair.${i}.d`}>{f.d}</p>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <!-- EXAMPLE — flow diagram (distinct from the join card) -->
  <section class="example wrap">
    <div class="sec-head" data-reveal>
      <span class="eyebrow"><span class="pip"></span><span data-i18n="example.badge">Beispiel</span></span>
      <h2 data-i18n="example.h2">Zusammen statt getrennt</h2>
    </div>
    <div class="flow" data-reveal>
      <div class="flow-sports">
        <span class="flow-icon" title="Beachvolleyball"><Icon path={sportIconPath('Beachvolleyball')} size={26} /></span>
        <span class="flow-icon" title="Outdoor-Boxen"><Icon path={sportIconPath('Outdoor-Boxen')} size={26} /></span>
        <span class="flow-icon" title="Schwimmen"><Icon path={sportIconPath('Schwimmen')} size={26} /></span>
      </div>
      <span class="flow-arrow"><Icon path={mdiArrowRight} size={30} /></span>
      <div class="flow-venue">
        <span class="flow-pin"><Icon path={mdiMapMarker} size={22} /></span>
        <span class="flow-venue-name">Strandbad Horn</span>
        <span class="flow-venue-sub" data-i18n="example.sub">alle drei an einem Ort</span>
      </div>
    </div>
    <p class="example-text" data-reveal data-i18n="example.body">
      Landen Beachvolleyball, Outdoor-Boxen und Schwimmen vorne, teilt der Club
      euch nicht auf drei Orte auf — er wählt das <strong>Strandbad Horn</strong>,
      wo alle drei am selben Ort möglich sind. Jeder macht seinen Sport und
      trotzdem seid ihr gemeinsam unterwegs.
    </p>
  </section>

  <!-- INVITE / CTA -->
  <section class="join wrap">
    <div class="join-card" data-reveal>
      <span class="badge"><Icon path={mdiCalendarStar} size={14} /> Cardiotag</span>
      <h2 data-i18n="join.h2">Noch geschlossen — aber nicht mehr lange.</h2>
      <p data-i18n="join.body">
        Messers Cardio Club startet als privater Kreis in Konstanz — wir testen
        gerade die App für euch. <strong>Sei einer der Ersten</strong> und sichere
        dir deinen Platz auf der Warteliste.
      </p>
      <div class="cta">
        <button class="btn btn-primary" type="button" data-open-waitlist><span data-i18n="join.cta">Auf die Warteliste</span> <Icon path={mdiArrowRight} /></button>
        <a class="btn btn-ghost" href={appUrl} data-i18n="join.have">Ich habe schon einen Code</a>
      </div>
    </div>
  </section>

  <!-- WAITLIST DIALOG -->
  <dialog class="waitlist" id="waitlist" aria-label="Einladungscode anfragen">
    <form class="wl-form" id="waitlist-form">
      <button class="wl-close" type="button" data-close-waitlist aria-label="Schließen">×</button>
      <span class="badge"><Icon path={mdiCalendarStar} size={14} /> <span data-i18n="wl.badge">Warteliste</span></span>
      <h3 data-i18n="wl.h3">Einladungscode anfragen</h3>
      <p data-i18n="wl.desc">
        Der Club ist noch geschlossen. Trag dich mit Name und Telefonnummer ein —
        wir melden uns, sobald ein Platz frei wird.
      </p>
      <label><span data-i18n="wl.name">Name</span>
        <input name="name" type="text" required maxlength="120" autocomplete="name" data-i18n-ph="wl.namePh" placeholder="Dein Name" />
      </label>
      <label><span data-i18n="wl.phone">Telefonnummer</span>
        <span class="phone-row">
          <select name="dial" class="dial-select" aria-label="Ländervorwahl">
            {dialCodes.map((d) => <option value={d.code}>{d.flag} {d.code}</option>)}
          </select>
          <input name="phone" type="tel" required maxlength="40" autocomplete="tel" data-i18n-ph="wl.phonePh" placeholder="151 23456789" />
        </span>
      </label>
      <input type="text" name="company" class="hp-field" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <button class="btn btn-primary" type="submit" data-wl-submit data-i18n="wl.submit">Auf die Warteliste setzen</button>
      <p class="wl-msg" data-wl-msg hidden></p>
      <p class="wl-fineprint" data-i18n="wl.fine">Mit dem Absenden stimmst du der Speicherung deiner Angaben zur Kontaktaufnahme zu (siehe <a href="/datenschutz">Datenschutz</a>).</p>
    </form>
  </dialog>
</Base>

<script>
  import '../scripts/live';
</script>

<style>
  /* HERO */
  .hero {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: clamp(26px, 4vw, 56px);
    align-items: center;
    padding-block: clamp(16px, 3vh, 40px) clamp(28px, 5vh, 64px);
  }
  h1 {
    font-size: clamp(2.3rem, 4.4vw, 3.4rem);
    line-height: 1.05; letter-spacing: -0.02em;
    margin: 0.5em 0 0.35em; font-weight: 900;
  }
  /* keep "Der Cardio-Club" on one line — never break at the hyphen */
  .h1-line { white-space: nowrap; }
  .grad {
    background: linear-gradient(120deg, var(--blue-soft), var(--blue) 35%, var(--blue-deep) 55%, var(--blue) 75%, var(--blue-soft));
    background-size: 220% 100%;
    -webkit-background-clip: text; background-clip: text; color: transparent;
    animation: grad-shift 7s ease-in-out infinite;
  }
  @keyframes grad-shift { 0%, 100% { background-position: 0% 50%; } 50% { background-position: 100% 50%; } }
  @media (prefers-reduced-motion: reduce) { .grad { animation: none; } }
  .lede { color: var(--text-dim); font-size: clamp(1.02rem, 1.4vw, 1.18rem); max-width: 46ch; }
  .lede strong { color: var(--text); font-weight: 700; }

  .invite-pill {
    display: inline-flex; align-items: center; gap: 0.7em;
    margin: 1.5rem 0 0; padding: 8px 16px; border-radius: 999px;
    background: var(--accent-faint);
    border: 1px solid var(--strong-line);
    font-size: 0.88rem; color: var(--text);
  }
  .invite-pill strong { color: var(--blue-soft); font-weight: 700; }

  .events-line {
    display: inline-flex; align-items: center; gap: 0.55em;
    margin: 0.9rem 0 0; font-size: 0.85rem; color: var(--text-dim);
  }
  .events-line[hidden] { display: none; }
  .live-dot {
    width: 8px; height: 8px; border-radius: 50%; flex: none; background: var(--mint);
    box-shadow: 0 0 0 0 rgba(94, 234, 212, 0.6);
    animation: ring-mint 2s ease-out infinite;
  }
  @keyframes ring-mint {
    0% { box-shadow: 0 0 0 0 rgba(94, 234, 212, 0.5); }
    70% { box-shadow: 0 0 0 8px rgba(94, 234, 212, 0); }
    100% { box-shadow: 0 0 0 0 rgba(94, 234, 212, 0); }
  }

  .dotpulse {
    width: 9px; height: 9px; border-radius: 50%; flex: none;
    background: var(--blue);
    box-shadow: 0 0 0 0 rgba(77, 163, 255, 0.6);
    animation: ring 2.2s ease-out infinite;
  }
  @keyframes ring {
    0%   { box-shadow: 0 0 0 0 rgba(77, 163, 255, 0.5); }
    70%  { box-shadow: 0 0 0 10px rgba(77, 163, 255, 0); }
    100% { box-shadow: 0 0 0 0 rgba(77, 163, 255, 0); }
  }

  .cta { display: flex; flex-wrap: wrap; gap: 14px; margin: 2rem 0 2.2rem; }

  .stats {
    display: flex; gap: clamp(22px, 5vw, 52px); margin: 0;
    padding-top: 1.5rem; border-top: 1px solid var(--line);
  }
  .stats div { display: flex; flex-direction: column; }
  .stats dt { font-size: clamp(1.7rem, 3vw, 2.3rem); font-weight: 900; line-height: 1; color: #fff; }
  .stats dd {
    margin: 0.4em 0 0; font-size: 0.8rem; letter-spacing: 0.04em;
    color: var(--text-dim); text-transform: uppercase; font-weight: 700;
  }

  .hero-map { display: flex; flex-direction: column; gap: 16px; }
  .map-caption {
    display: inline-flex; align-items: center; gap: 0.6em;
    font-size: 0.82rem; color: var(--text-dim); margin: 0;
  }
  .map-caption .pip {
    width: 8px; height: 8px; border-radius: 50%; background: var(--blue);
    box-shadow: 0 0 10px 2px var(--blue); flex: none;
  }

  /* Section heads */
  .sec-head { margin-bottom: 2.2rem; }
  .sec-head h2 {
    font-size: clamp(1.7rem, 3.2vw, 2.5rem); letter-spacing: -0.01em;
    margin: 0.5em 0 0.3em; font-weight: 900; text-wrap: balance;
  }
  /* Only the body copy is width-limited for readability — not the heading. */
  .sec-lede { color: var(--text-dim); margin: 0; max-width: 54ch; }

  /* ECG signature divider — pulled tight to the neighbouring sections */
  .ecg { padding-block: 0; margin-block: clamp(-30px, -2vh, -14px); }
  .ecg svg {
    width: 100%; height: 48px; display: block; overflow: visible;
    /* fade both ends so the line / travelling pulse never looks hard-cut */
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 12%, #000 88%, transparent 100%);
    mask-image: linear-gradient(90deg, transparent 0, #000 12%, #000 88%, transparent 100%);
  }
  .ecg-base { fill: none; stroke: rgba(77, 163, 255, 0.14); stroke-width: 2; }
  .ecg-pulse {
    fill: none; stroke: var(--blue); stroke-width: 2.5;
    stroke-linecap: round; stroke-linejoin: round;
    filter: drop-shadow(0 0 6px rgba(77, 163, 255, 0.85));
    stroke-dasharray: 180 1300;
    animation: ecg-run 3.2s linear infinite;
  }
  @keyframes ecg-run { from { stroke-dashoffset: 1480; } to { stroke-dashoffset: 0; } }
  @media (prefers-reduced-motion: reduce) {
    .ecg-pulse { animation: none; stroke-dasharray: none; opacity: 0.5; }
  }

  /* USP — what makes the club special */
  .usp { padding-block: clamp(28px, 5vh, 64px); }
  .usp-grid { display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }
  .usp-card {
    padding: 26px 24px; border-radius: 20px;
    border: 1px solid var(--line); background: var(--surface);
    transition: border-color 0.25s ease, transform 0.18s ease;
  }
  .usp-card:hover { border-color: var(--strong-line); transform: translateY(-3px); }
  .usp-icon {
    display: inline-flex; align-items: center; justify-content: center;
    width: 54px; height: 54px; border-radius: 15px; color: var(--blue);
    background: radial-gradient(circle at 50% 30%, rgba(77, 163, 255, 0.2), rgba(77, 163, 255, 0.04));
    border: 1px solid var(--strong-line); box-shadow: inset 0 0 16px rgba(77, 163, 255, 0.12);
  }
  .usp-card h3 { margin: 0.9em 0 0.35em; font-size: 1.18rem; font-weight: 900; }
  .usp-card p { margin: 0; color: var(--text-dim); line-height: 1.55; }

  /* SPORTS (tile styles are global so they apply to live-rendered tiles too) */
  .sports { padding-block: clamp(24px, 4vh, 56px); }

  /* YOUR PART */
  .part { padding-block: clamp(20px, 4vh, 48px); }
  .part-grid {
    display: grid; gap: 16px;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }
  .part-card {
    position: relative; padding: 24px 22px;
    border-radius: 20px; border: 1px solid var(--line);
    background: var(--surface);
    overflow: hidden;
    transition: border-color 0.25s ease, transform 0.18s ease;
  }
  .part-card:hover { border-color: var(--strong-line); transform: translateY(-3px); }
  .part-icon {
    display: inline-flex; align-items: center; justify-content: center;
    width: 44px; height: 44px; border-radius: 14px;
    background: var(--accent-faint); border: 1px solid var(--strong-line);
    color: var(--blue);
  }
  .part-n {
    position: absolute; top: 22px; right: 22px;
    font-size: 0.82rem; font-weight: 900; letter-spacing: 0.16em;
    color: var(--text-muted);
  }
  .part-card h3 { margin: 0.9em 0 0.35em; font-size: 1.16rem; font-weight: 900; }
  .part-card p { margin: 0; color: var(--text-dim); font-size: 0.95rem; line-height: 1.5; }

  /* FAIRNESS */
  .fair { padding-block: clamp(30px, 5vh, 64px); }
  .fair-grid {
    list-style: none; margin: 0; padding: 0;
    display: grid; gap: 14px;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  }
  .fair-card {
    display: flex; gap: 14px; align-items: flex-start;
    padding: 18px 18px; border-radius: 16px;
    border: 1px solid var(--line); background: rgba(255, 255, 255, 0.02);
    transition: border-color 0.25s ease;
  }
  .fair-card:hover { border-color: var(--strong-line); }
  .fair-icon {
    display: inline-flex; align-items: center; justify-content: center;
    width: 40px; height: 40px; border-radius: 12px; flex: none;
    background: var(--accent-faint); border: 1px solid var(--strong-line);
    color: var(--blue);
  }
  .fair-card h3 { margin: 0 0 0.3em; font-size: 1.02rem; font-weight: 900; }
  .fair-card p { margin: 0; color: var(--text-dim); font-size: 0.9rem; line-height: 1.5; }

  /* EXAMPLE + JOIN cards */
